#!/usr/bin/env python3
"""Delegate work from Claude Code to Codex / Cursor agents.

  delegate quota                      remaining quota + reset per pool
  delegate ratings [--refresh]        AA ratings for catalog models
  delegate route <task>               rank delegates for a task type
  delegate catalog [--json]           show personal overlay path, overrides, or merged JSON
  delegate launch codex|cursor ...    worktree + brief + background run (--preflight: verify only)
  delegate review RUN | --working-tree --brief F   read-only review (run: other vendor; working-tree: both)
  delegate followup RUN --brief F     next round in the same worktree, resuming the agent session
  delegate verify RUN [--cmd C]       re-run the run's check command in its worktree
  delegate status [RUN]               runs overview / one run in detail
  delegate wait RUN [RUN ...]         block until run(s) finish (incl. verifying)
  delegate diff RUN                   diff stat + changes.patch
  delegate apply RUN [--check]        apply the reviewed patch to the main checkout
  delegate cleanup RUN                remove worktree + branch
"""
import argparse
import importlib
import json
import sys
from pathlib import Path

import catalog
import quota
import ratings
import route
import runs

CATALOG = Path(__file__).resolve().parent / "catalog.json"


def load_catalog():
    return catalog.load(CATALOG)


def cmd_catalog(a):
    merged, info = catalog.load_details(CATALOG)
    if info["status"] == "off":
        local_line = "local: off (DELEGATE_CATALOG_LOCAL is empty)"
    elif info["status"] == "missing":
        local_line = f"local: none (would read {info['would_read']})"
    else:
        local_line = f"local: {info['local']}"
    if a.json:
        print(local_line, file=sys.stderr)
        if info["overrides"]:
            for path in info["overrides"]:
                print(path, file=sys.stderr)
        else:
            print("no overrides", file=sys.stderr)
        print(json.dumps(merged, indent=2))
        return
    print(local_line)
    if info["overrides"]:
        for path in info["overrides"]:
            print(path)
    else:
        print("no overrides")


def cmd_quota(a):
    if getattr(a, "unused", False):
        if a.snapshot:
            sys.exit("quota --unused cannot be combined with --snapshot")
        # Catalog before any log/network work so a broken local file is reported first.
        cat = load_catalog()
        import monitor
        pools = None
        if a.pool:
            pools = [p.strip() for p in a.pool.split(",") if p.strip()]
            unknown = [p for p in pools if p not in quota.POOLS]
            if unknown:
                sys.exit(f"unknown pool(s): {', '.join(unknown)}")
        now = None
        if a.now:
            now = quota.parse_ts(a.now)
            if now is None:
                sys.exit(f"invalid --now timestamp: {a.now!r}")
        out = monitor.unused(
            log=a.log, run_log=a.run_log, session_log=a.session_log,
            since=a.since, pools=pools, now=now, catalog=cat, as_json=a.json,
        )
        print(json.dumps(out, indent=2) if a.json else out)
        return
    source = a.source or ("direct" if a.snapshot else "auto")
    if a.snapshot:
        sys.exit(quota.snapshot(reason=a.reason, session=a.session, run=a.run,
                                if_active=a.if_active, log=a.log, source=source,
                                job=getattr(a, "job", None)))
    res = quota.pools(quota.fetch(source))
    if a.json:
        print(json.dumps(res, indent=2))
        return
    rounds_lines = []
    try:
        import monitor
        groups = monitor.load_cost_groups(catalog=load_catalog())
        rounds_lines = monitor.render_rounds_left_lines(groups, res)
    except Exception:
        rounds_lines = []
    print(quota.render(res, rounds_lines=rounds_lines))


def cmd_ratings(a):
    # Catalog before the AA fetch so a broken local file is not masked by network errors.
    cat = load_catalog()
    env = ratings.load(refresh=a.refresh, log=lambda m: print(m, file=sys.stderr))
    models = env["models"]
    if a.grep:
        import re
        pat = re.compile(a.grep, re.I)
        picks = [(s, s) for s in models if pat.search(s) or pat.search(models[s].get("name") or "")]
    else:
        picks = [(d["id"], d.get("aa")) for d in cat["delegates"]]
    if a.json:
        print(json.dumps({k: models.get(s) for k, s in picks}, indent=2))
        return
    import time
    print(f"source: {env['source']}, fetched {time.strftime('%Y-%m-%d %H:%M', time.localtime(env['fetched_at']))}"
          f"{'  (coding = proxy: mean of Terminal-Bench 4.0 and SciCode)' if env['source'] != 'api' else ''}")
    f = lambda v, s: format(v, s) if v is not None else "-"
    body = []
    for key, slug in picks:
        m = models.get(slug) if slug else None
        if not m:
            body.append((-1, (key, slug or "(no AA rating)", "-", "-", "-", "-", "-", "-", "-")))
            continue
        body.append((m["intelligence"] or 0,
                     (key, slug, f(m["intelligence"], ".1f"), f(m["coding"], ".1f"), f(m["tps"], ".0f"),
                      f(m["price_in"], ".2f"), f(m["price_out"], ".2f"), f(m["price_blended"], ".2f"),
                      f(m.get("cost_per_task"), ".3f"))))
    body.sort(key=lambda t: -t[0])
    rows = [("ID", "AA SLUG", "INT", "COD", "TOK/S", "$IN", "$OUT", "$BLEND", "$/TASK")] + [r for _, r in body]
    w = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(x) for c, x in zip(r, w)).rstrip())


def cmd_route(a):
    cat = load_catalog()
    if a.frontier:
        import frontier
        report = frontier.load_report(cat, refresh=a.refresh)
        print(json.dumps(report, indent=2) if a.json else frontier.render(report, cat))
        return
    if a.task not in cat["tasks"]:
        sys.exit(f"unknown task {a.task!r}; known: {', '.join(cat['tasks'])}")
    pools = quota.pools(quota.fetch(a.source))
    aa = ratings.load(refresh=a.refresh, log=lambda m: print(m, file=sys.stderr))["models"]
    agents = set(a.agents.split(",")) if a.agents else None
    options = {"min_quota": a.min_quota, "agents": agents}
    if a.prefer is not None:
        options["prefer"] = [s.strip() for s in a.prefer.split(",") if s.strip()]
    task, rows = route.rank(a.task, cat, pools, aa, **options)
    try:
        import monitor
        groups = monitor.load_cost_groups(catalog=cat)
        monitor.annotate_route_rows(rows, groups, pools)
    except Exception:
        for r in rows:
            r.setdefault("rounds_left", None)
            r.setdefault("round_cost", None)
    if a.json:
        print(json.dumps([{"id": r["delegate"]["id"], "score": r["score"], "quality": r["quality"],
                           "quota_left": r["left"], "pace": r["pace"], "excluded": r["excluded"],
                           "metrics": r["metrics"], "source": r["source"],
                           "rounds_left": r.get("rounds_left"),
                           "round_cost": r.get("round_cost"),
                           "launch": route.launch_hint(r["delegate"], task)} for r in rows], indent=2))
        return
    print(route.render(a.task, task, rows))


def main():
    p = argparse.ArgumentParser(prog="delegate", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("quota", help="remaining quota and reset time per pool")
    s.add_argument("--json", action="store_true")
    s.add_argument("--source", choices=["auto", "direct", "daemon"],
                   help="openusage collection source; 'direct' polls providers now (slower, fresher)")
    s.add_argument("--snapshot", action="store_true", help="append a quota.jsonl reading (default source: direct)")
    s.add_argument("--unused", action="store_true",
                   help="report closed quota windows' unused share and per-job pool costs from local logs")
    s.add_argument("--since", help="with --unused: keep windows/jobs ending/starting on or after this date")
    s.add_argument("--pool", help="with --unused: comma-separated pool ids")
    s.add_argument("--now", help="with --unused: ISO time with offset (reproducible reports)")
    s.add_argument("--run-log", help="with --unused: runs.jsonl path")
    s.add_argument("--session-log", help="with --unused: sessions.jsonl path")
    s.add_argument("--reason", choices=["session-start", "session-end", "backfill", "launch",
                                        "timer", "manual", "job-end"])
    s.add_argument("--session")
    s.add_argument("--run")
    s.add_argument("--job", help="with --snapshot: round-N or review-N job id")
    s.add_argument("--if-active", action="store_true", help="poll only when a timer reading is due")
    s.add_argument("--log", help="snapshot / --unused quota JSONL path")
    s.set_defaults(fn=cmd_quota)

    s = sub.add_parser("ratings", help="Artificial Analysis ratings for catalog models")
    s.add_argument("--refresh", action="store_true", help="ignore the 24h cache")
    s.add_argument("--grep", help="show all AA models matching this regex instead of the catalog")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_ratings)

    s = sub.add_parser("route", help="rank delegates for a task type")
    s.add_argument("task", nargs="?", help="review | refactor | implement | research | bulk-label (see catalog.json)")
    s.add_argument("--frontier", action="store_true", help="report runnable models on AA cost/intelligence frontiers")
    s.add_argument("--agents", help="comma list to restrict: codex,cursor,claude-subagent")
    s.add_argument("--prefer", help="comma list of preferred delegate IDs")
    s.add_argument("--min-quota", type=float, help="exclude pools below this %% left (default from catalog)")
    s.add_argument("--refresh", action="store_true")
    s.add_argument("--source", default="auto", choices=["auto", "direct", "daemon"])
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_route)

    s = sub.add_parser("catalog", help="show personal catalog.local.json path and overrides")
    s.add_argument("--json", action="store_true",
                   help="print the merged catalog on stdout; path and overrides on stderr")
    s.set_defaults(fn=cmd_catalog)

    s = sub.add_parser("launch", help="start a delegate in its own worktree")
    s.add_argument("agent", choices=["codex", "cursor"])
    s.add_argument("--brief", required=True, help="markdown brief file")
    s.add_argument("--model", help="codex default gpt-6.1-sol (@xhigh); cursor default auto")
    s.add_argument("--effort", help="codex reasoning effort (low..xhigh, max)")
    s.add_argument("--name", help="run name (default <agent>-<timestamp>); branch is delegate/<name>")
    s.add_argument("--repo", help="repo path (default: cwd)")
    s.add_argument("--base", help="commit-ish to branch from (default HEAD)")
    s.add_argument("--root", help=f"run directory (default {runs.RUNS_ROOT}/<repo>/<name>)")
    s.add_argument("--link", action="append", default=[],
                   help="repo-relative gitignored path to symlink into the worktree (repeatable), e.g. data/cache")
    s.add_argument("--include-uncommitted", action="store_true",
                   help="snapshot the main checkout's dirty tree (tracked + non-ignored untracked) as "
                        "the run's base; incompatible with --base; refuses >100 untracked files or "
                        "10 MiB unless --all-untracked")
    s.add_argument("--all-untracked", action="store_true",
                   help="with --include-uncommitted: allow more than 100 untracked files or 10 MiB total")
    s.add_argument("--read-only", action="store_true", help="codex -s read-only / cursor --mode ask")
    s.add_argument("--unsandboxed", action="store_true",
                   help="cursor only: --sandbox disabled --force (needed for network, e.g. installs); ask the user first")
    s.add_argument("--web-search", action="store_true",
                   help="codex only: enable the live web_search tool (server-side; the shell stays offline), "
                        "e.g. for research runs")
    s.add_argument("--detach", action="store_true",
                   help="return immediately (default: block until done; run it with run_in_background)")
    s.add_argument("--verify", metavar="CMD",
                   help="shell command run in the worktree after the agent exits (e.g. the test suite); "
                        "result in verify.log / verify_code")
    s.add_argument("--preflight", action="store_true",
                   help="create the worktree and --link symlinks, run --verify once in the scrubbed "
                        "worktree env, print the result, then roll back (no agent); requires --verify; "
                        "incompatible with --dry-run and --detach")
    s.add_argument("--dry-run", action="store_true", help="print run.sh and prompt, create nothing")
    s.set_defaults(fn=runs.launch)

    s = sub.add_parser("followup", help="next round in the same worktree (resumes the agent session)")
    s.add_argument("run")
    s.add_argument("--brief", help="markdown file with what to change next")
    s.add_argument("--from-review", type=int, metavar="N", help="append review N's findings to the brief")
    s.add_argument("--fresh", action="store_true",
                   help="new session instead of resuming (e.g. with a stronger --model after repeated failures)")
    s.add_argument("--model")
    s.add_argument("--effort")
    s.add_argument("--verify", metavar="CMD", help="override the run's verify command")
    s.add_argument("--link", action="append", default=[],
                   help="repo-relative gitignored path to symlink into the worktree (repeatable)")
    s.add_argument("--detach", action="store_true")
    s.add_argument("--dry-run", action="store_true", help="show what would run; archive nothing")
    s.set_defaults(fn=runs.followup)

    s = sub.add_parser("review", help="read-only review of a run's changes, or of uncommitted main-tree work")
    s.add_argument("run", nargs="?", help="run name (omit with --working-tree)")
    s.add_argument("--working-tree", action="store_true",
                   help="review uncommitted work in the main checkout (tracked + untracked); "
                        "both vendors by default")
    s.add_argument("--brief", help="with --working-tree: intent/spec file (required); stored as the run's brief")
    s.add_argument("--base", help="with --working-tree: diff base commit-ish (default HEAD)")
    s.add_argument("--name", help="with --working-tree: run name (default wt-<timestamp>)")
    s.add_argument("--link", action="append", default=[],
                   help="with --working-tree: repo-relative gitignored path to symlink into the "
                        "snapshot worktree (repeatable)")
    s.add_argument("--all-untracked", action="store_true",
                   help="with --working-tree: allow more than 100 untracked files or 10 MiB total")
    s.add_argument("--no-fallback", action="store_true",
                   help="with --working-tree both-reviewers: keep Codex even when its quota is empty")
    s.add_argument("--agent", choices=["codex", "cursor"],
                   help="run review: other vendor by default; working-tree: both vendors by default")
    s.add_argument("--model", help="codex default gpt-6.1-sol (@xhigh); cursor default auto")
    s.add_argument("--effort")
    s.add_argument("--focus", help="extra review focus, e.g. 'race conditions in the cache'")
    s.add_argument("--patch-max-kb", type=int, default=200, metavar="N",
                   help="omit any single-file diff larger than N KB from the review patch "
                        "(default 200; 0 keeps the full diff). changes.patch is never trimmed")
    s.add_argument("--detach", action="store_true")
    s.add_argument("--dry-run", action="store_true", help="print the review prompt; start nothing")
    s.set_defaults(fn=runs.review)

    s = sub.add_parser("verify", help="re-run the run's check command in its worktree")
    s.add_argument("run")
    s.add_argument("--cmd", help="command to run instead of the stored one")
    s.set_defaults(fn=runs.verify)

    s = sub.add_parser("status", help="list runs, or details for given runs")
    s.add_argument("runs", nargs="*", help="run name or directory")
    s.add_argument("--log", type=int, default=15, help="log lines to show")
    s.add_argument("--full", action="store_true", help="also show the log tail and whole last message")
    s.set_defaults(fn=runs.status)

    s = sub.add_parser("wait", help="block until run(s) leave busy states (running/verifying)")
    s.add_argument("runs", nargs="+", help="run name or directory")
    s.add_argument("--timeout", type=float, default=3600, help="seconds to wait (default 3600)")
    s.add_argument("--interval", type=float, default=10, help="poll interval seconds (default 10)")
    s.set_defaults(fn=runs.wait)

    s = sub.add_parser("diff", help="write changes.patch for a run and show its stat")
    s.add_argument("run")
    s.add_argument("--full", action="store_true", help="also print the patch")
    s.set_defaults(fn=runs.diff)

    s = sub.add_parser("apply", help="apply a run's patch to the main checkout (after review)")
    s.add_argument("run")
    s.add_argument("--check", action="store_true", help="only test whether it applies")
    s.add_argument("--3way", dest="three_way", action="store_true",
                   help="fall back to 3-way merge via a temp index (working files updated, nothing staged)")
    s.set_defaults(fn=runs.apply)

    s = sub.add_parser("cleanup", help="remove a run's worktree and branch")
    s.add_argument("run")
    s.add_argument("--force", action="store_true", help="discard unapplied changes")
    s.add_argument("--keep-branch", action="store_true")
    s.add_argument("--purge", action="store_true", help="also delete the run record (log, brief, last message)")
    s.set_defaults(fn=runs.cleanup)

    s = sub.add_parser("_cursor-last")
    s.add_argument("root")
    s.set_defaults(fn=lambda a: runs.cursor_last(Path(a.root)))

    s = sub.add_parser("_finalize")
    s.add_argument("root")
    s.set_defaults(fn=lambda a: runs.finalize(Path(a.root)))

    for name in ("cost", "ask", "report", "rate", "prereg"):
        try:
            mod = importlib.import_module(name)
        except ImportError:
            continue
        mod.register(sub)

    # Internal lifecycle helpers remain callable but stay out of CLI help.
    sub._choices_actions[:] = [c for c in sub._choices_actions if not c.dest.startswith("_")]
    sub.metavar = "{" + ",".join(k for k in sub.choices if not k.startswith("_")) + "}"

    a = p.parse_args()
    if a.cmd == "route":
        if a.frontier and a.task is not None:
            p.error("route --frontier cannot be used with a task")
        if not a.frontier and a.task is None:
            p.error("route requires a task or --frontier")
    if a.cmd == "quota" and a.snapshot and getattr(a, "unused", False):
        p.error("quota --unused cannot be combined with --snapshot")
    if a.cmd == "quota" and a.snapshot and not a.if_active and a.reason is None:
        p.error("quota --snapshot requires --reason unless --if-active is set")
    try:
        a.fn(a)
    except catalog.CatalogError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    main()
