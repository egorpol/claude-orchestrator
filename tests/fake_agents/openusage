#!/usr/bin/env python3
"""Local openusage export fixture; optionally select an envelope by --source."""
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path


args = sys.argv[1:]
assert args[0] == "export", args
source = args[args.index("--source") + 1]
if os.environ.get("FAKE_OPENUSAGE_LOG"):
    with Path(os.environ["FAKE_OPENUSAGE_LOG"]).open("a") as stream:
        stream.write(source + "\n")
code = int(os.environ.get("FAKE_OPENUSAGE_EXIT", "0"))
if code:
    sys.exit(code)
if os.environ.get("FAKE_OPENUSAGE_FILE"):
    fixture = json.loads(Path(os.environ["FAKE_OPENUSAGE_FILE"]).read_text())
    print(json.dumps(fixture.get(source, fixture)))
else:
    now = datetime.now(timezone.utc)
    print(json.dumps({"snapshots": [{
        "provider_id": "codex", "timestamp": now.isoformat(), "status": "ok",
        "metrics": {"rate_limit_primary": {"remaining": 80, "limit": 100},
                    "rate_limit_secondary": {"remaining": 70, "limit": 100}},
        "resets": {"rate_limit_primary": (now + timedelta(hours=2)).isoformat(),
                   "rate_limit_secondary": (now + timedelta(days=2)).isoformat()},
    }]}))
