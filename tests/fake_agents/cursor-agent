#!/usr/bin/env python3
"""Quota-free Cursor fixture: stream-json (-p) or interactive /usage TUI (no -p)."""
import json
import os
import select
import signal
import sys
import time
from pathlib import Path


args = sys.argv[1:]

# Interactive TUI branch for hybrid Cursor /usage reads (never -p).
if "-p" not in args:
    # Frames like the real TUI's (feedback/cursor-usage-capture-*.bin): each redraw
    # erases the previous frame's lines (ESC[2K ESC[1A ... ESC[2K ESC[G), then rewrites.
    PLACEHOLDER = (b' \x1b[48;5;233m \x1b[2m\xe2\x86\x92 \x1b[22m\x1b[7mP\x1b[27m'
                   b'\x1b[2mlan, search, build anything\x1b[22m')
    # The model name in the status line is a bare "Auto" (must not match gauges).
    STATUS = b'  Ask (shift+tab to cycle)  Auto  /ws'
    INPUT = b'  \xe2\x86\x92 '
    ROW_USAGE_SELECTED = (b'   \xe2\x86\x92 \x1b[1m/usage\x1b[22m                    '
                          b'\x1b[1mShow plan and on-demand usage\x1b[22m')
    ROW_USAGE = (b'     \x1b[1m/usage\x1b[22m                    '
                 b'\x1b[1mShow plan and on-demand usage\x1b[22m')
    ROW_UPDATE_SELECTED = (b'   \xe2\x86\x92 \x1b[1m/update\x1b[22m                   '
                           b'\x1b[1mCheck for updates\x1b[22m')
    ROW_CONTEXT = b'     /context                  Show context usage breakdown'
    LOADING = b'\r\n\r\n  \x1b[36mLoading usage data...\x1b[39m\r\n\x1b[2K\x1b[1A\x1b[2K'
    RESETS = b'  Usage  \xe2\x80\xa2  Pro                         \x1b[2mResets 18 Nov\x1b[22m\r\n'
    TABLE = (
        b'Monthly plan and on-demand usage\r\n'
        b'Category  Current  Usage\r\n'
        b'Included        55% used      \xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\r\n'
        b'Auto            55% used      \xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\r\n'
        b'API             46% used      \xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\r\n'
        b'On-Demand  Disabled  \xe2\x80\x94\xe2\x80\x94\xe2\x80\x94\r\n'
        b'On-demand usage is off\r\n'
        b'View in dashboard:  cursor.com/dashboard?tab=usage\r\n'
        b'Esc to close\r\n'
    )
    TABLE_NO_AUTO = (
        b'Monthly plan and on-demand usage\r\n'
        b'Category  Current  Usage\r\n'
        b'Included        55% used\r\n'
        b'API             46% used\r\n'
        b'Esc to close\r\n'
    )

    case = os.environ.get("FAKE_CURSOR_TUI", "normal")
    log_path = os.environ.get("FAKE_CURSOR_TUI_LOG")
    env_log = os.environ.get("FAKE_CURSOR_TUI_ENV")
    if env_log:
        with Path(env_log).open("a", encoding="utf-8") as stream:
            stream.write(json.dumps({
                "argv": args,
                "cwd": os.getcwd(),
                "LANG": os.environ.get("LANG"),
                "LC_ALL": os.environ.get("LC_ALL"),
                "TERM": os.environ.get("TERM"),
            }) + "\n")

    # The real TUI runs raw; in canonical mode typed keys wait for a newline.
    import tty
    tty.setraw(sys.stdin.fileno())

    def log_bytes(data):
        if not log_path or not data:
            return
        with Path(log_path).open("ab") as stream:
            stream.write(data)

    def emit(data):
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()

    def read_available(timeout=0.05):
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if not ready:
            return b""
        try:
            chunk = os.read(sys.stdin.fileno(), 4096)
        except OSError:
            return b""
        log_bytes(chunk)
        return chunk

    frame_height = [0]

    def frame(*lines):
        erase = b""
        if frame_height[0]:
            erase = b"\x1b[2K\x1b[1A" * (frame_height[0] - 1) + b"\x1b[2K\x1b[G"
        frame_height[0] = len(lines) + 1
        return erase + b"\r\n".join(lines) + b"\r\n"

    def banner():
        return b"\x1b[49m" + frame(b"", PLACEHOLDER, b"", STATUS)

    def drain(seconds):
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            read_available(min(0.05, max(0, end - time.monotonic())))

    if case == "ignore_signals":
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        child = os.fork()
        if child == 0:
            signal.signal(signal.SIGINT, signal.SIG_IGN)
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            while True:
                time.sleep(60)
        # Keep writing nothing useful; parent reader must kill the group.
        emit(banner())
        while True:
            read_available(0.2)

    if case == "hang_before_ready":
        while True:
            read_available(0.2)

    if case == "login":
        emit(b'\x1b[49m\r\nPlease log in to continue\r\n')
        while True:
            read_available(0.2)

    if case == "flood":
        emit(banner())
        # Flood past the 1 MiB collector cap while the reader is still waiting/typing.
        emit(b"x" * (2 * 1024 * 1024))
        while True:
            read_available(0.2)

    emit(banner())
    if case == "exit_early":
        sys.exit(3)
    typed = b""
    saw_enter = False
    while not saw_enter:
        chunk = read_available(0.05)
        if not chunk:
            continue
        for byte in chunk:
            one = bytes([byte])
            if one == b"\r":
                saw_enter = True
                break
            typed += one
            if typed in (b"/", b"/u", b"/us", b"/usa", b"/usag"):
                # The real menu selects /usage from "/u" on, before the last character.
                emit(frame(INPUT + typed, ROW_USAGE_SELECTED, ROW_CONTEXT, STATUS))
            elif typed == b"/usage":
                if case == "no_usage_menu":
                    emit(frame(INPUT + typed, ROW_UPDATE_SELECTED, STATUS))
                elif case == "other_row_selected":
                    emit(frame(INPUT + typed, ROW_UPDATE_SELECTED, ROW_USAGE, STATUS))
                elif case == "description_before_last_char":
                    # The row selected at "/usag" is gone once "/usage" is typed.
                    emit(frame(INPUT + typed, b"  (menu)", STATUS))
                elif case == "menu_dismissed":
                    # Selected row, then menu cleared and prompt restored, in one write.
                    emit(frame(INPUT + typed, ROW_USAGE_SELECTED, ROW_CONTEXT, STATUS)
                         + frame(b"", PLACEHOLDER, b"", STATUS))
                elif case == "menu_dismissed_late":
                    # The same, 20 ms apart: the reader may see the row alone first.
                    emit(frame(INPUT + typed, ROW_USAGE_SELECTED, ROW_CONTEXT, STATUS))
                    time.sleep(0.02)
                    emit(frame(b"", PLACEHOLDER, b"", STATUS))
                elif case == "menu_cleared_input_kept":
                    # Menu gone, "/usage" still typed: Enter would send it as a prompt.
                    emit(frame(INPUT + typed, ROW_USAGE_SELECTED, ROW_CONTEXT, STATUS)
                         + frame(INPUT + typed, b"", STATUS))
                else:
                    emit(frame(INPUT + typed, ROW_USAGE_SELECTED, ROW_CONTEXT, STATUS))

    if case == "hang_after_enter":
        while True:
            read_available(0.2)

    emit(LOADING)
    if case == "no_meters":
        emit(b"\r\nEsc to close\r\n")
        drain(30)
        sys.exit(0)
    if case == "late_meters":
        emit(b"\r\nEsc to close\r\n")
        time.sleep(0.5)
        emit(RESETS + TABLE)
        drain(30)
        sys.exit(0)
    if case == "no_auto_row":
        emit(RESETS + TABLE_NO_AUTO)
        drain(30)
        sys.exit(0)
    # normal and any unspecified case
    emit(RESETS + TABLE)
    drain(30)
    sys.exit(0)


# Existing stream-json fixture used by launch/review lifecycle tests.
assert "-p" in args and args[args.index("--output-format") + 1] == "stream-json"
if "--sandbox" in args and args[args.index("--sandbox") + 1] == "enabled":
    assert "--force" not in args
if "--resume" in args:
    assert args[args.index("--resume") + 1] == "fake-cursor-session"
assert not any(k in os.environ for k in ("CLAUDECODE", "VSCODE_FAKE", "LD_LIBRARY_PATH"))

LIMIT_LINE = (
    "ActionRequiredError: You've hit your usage limit You've saved $309 on API model "
    "usage this month with Pro. Switch to a different model or set a Spend Limit to "
    "continue with this model. Your usage limits will reset when your monthly cycle "
    "ends on 11/18/2026.\n"
)


def emit(event):
    event["session_id"] = "fake-cursor-session"
    print(json.dumps(event), flush=True)


def assistant(text):
    emit({"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": text}]}})


limit = os.environ.get("FAKE_CURSOR_LIMIT")
if limit == "before":
    # Verbatim plain-text failure; no stream-json at all (real logs do this sometimes).
    sys.stderr.write(LIMIT_LINE)
    sys.exit(1)
if limit == "mid":
    emit({"type": "system", "subtype": "init", "model": "auto"})
    for i in range(3):
        emit({"type": "thinking", "subtype": "delta", "text": f"thinking-{i}"})
    sys.stderr.write(LIMIT_LINE)
    sys.exit(1)
if limit == "crash":
    # Non-zero exit with no usage-limit line and no answer → verdict unclear.
    emit({"type": "system", "subtype": "init", "model": "auto"})
    sys.exit(1)
if limit == "quoted":
    # Limit text only inside a JSON string (no log line starts with ActionRequiredError:).
    quoted = "## Findings\n" + LIMIT_LINE
    emit({"type": "system", "subtype": "init", "model": "auto"})
    assistant(quoted)
    emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1500,
          "result": quoted,
          "usage": {"inputTokens": 110, "outputTokens": 25, "cacheReadTokens": 900, "cacheWriteTokens": 30}})
    sys.exit(1)

wt = Path(args[args.index("--workspace") + 1])
prompt = args[-1]
read_only = "--mode" in args and args[args.index("--mode") + 1] == "ask"
review = prompt.startswith("# Review request")
if not read_only:
    with (wt / "tracked.txt").open("a") as f:
        f.write("cursor round\n")
    with (wt / "new-cursor.txt").open("a") as f:
        f.write("new cursor line\n")
if review:
    assert read_only
    assert list((wt / ".delegate").glob("review-*.verify.log"))
    answer = "## Verdict\nVerdict: CHANGES REQUESTED\n## Findings\n- [high] `tracked.txt:1`: fixture finding. Evidence: line. Fix: follow up.\n- [medium] `tracked.txt:2`: fixture finding. Evidence: line. Fix: follow up.\n- [low] `tracked.txt:3`: fixture finding. Evidence: line. Fix: follow up.\n## Spec compliance\n- partly\n"
else:
    answer = "## Changes\nUpdated tracked.txt and new-cursor.txt.\n## Verification\nChecks passed.\n## Open questions / conflicts\nNone.\n"
answer += "\n## Digest\nfiles: tracked.txt (+1/-0); new-cursor.txt (+1/-0)\nverify: git diff --check -> pass\nconflicts: none\nrisks: none\n"

emit({"type": "system", "subtype": "init", "model": "auto"})
assistant("Earlier narration, omitted from the final message.")
emit({"type": "tool_call", "subtype": "started", "tool_call": {"readToolCall": {"args": {"path": "tracked.txt"}}}})
emit({"type": "tool_call", "subtype": "completed", "tool_call": {"readToolCall": {"args": {"path": "tracked.txt"}, "result": {"content": "base"}}}})
assistant(answer)
emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1500,
      "result": "Earlier narration, omitted from the final message." + answer,
      "usage": {"inputTokens": 110, "outputTokens": 25, "cacheReadTokens": 900, "cacheWriteTokens": 30}})
if limit == "verdict-then-limit":
    # A real limit line after a parsed verdict must leave the verdict alone.
    sys.stderr.write(LIMIT_LINE)
    sys.exit(1)
sys.exit(int(os.environ.get("FAKE_AGENT_EXIT", "0")))
