#!/usr/bin/env python3
"""Quota-free codex exec fixture with native JSON events and a final message."""
import json
import os
from pathlib import Path
import sys


args = sys.argv[1:]
if args[0] == "app-server":
    import subprocess
    import time
    from datetime import datetime, timezone

    assert args == ["app-server", "--stdio"], args
    mode = os.environ.get("FAKE_CODEX_MODE", "ok")
    if os.environ.get("FAKE_CODEX_PIDS"):
        with Path(os.environ["FAKE_CODEX_PIDS"]).open("a") as stream:
            stream.write(str(os.getpid()) + "\n")
    if mode in ("grandchild", "exit-grandchild"):
        child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
        if os.environ.get("FAKE_CODEX_PIDS"):
            with Path(os.environ["FAKE_CODEX_PIDS"]).open("a") as stream:
                stream.write(str(child.pid) + "\n")
        if mode == "exit-grandchild":
            sys.exit(0)
    if mode in ("silent", "grandchild"):
        time.sleep(60)
    if mode == "eof-init":
        sys.exit(0)
    for line in sys.stdin:
        request = json.loads(line)
        if request["method"] == "initialized":
            continue
        if request["method"] == "initialize":
            assert "clientInfo" in request["params"]
            print(json.dumps({"method": "remoteControl/status/changed", "params": {}}), flush=True)
            print(json.dumps({"id": request["id"], "result": {}}), flush=True)
            continue
        assert request["method"] == "account/rateLimits/read", request
        if os.environ.get("FAKE_CODEX_LOG"):
            with Path(os.environ["FAKE_CODEX_LOG"]).open("a") as stream:
                stream.write("read\n")
        time.sleep(float(os.environ.get("FAKE_CODEX_SLEEP", "0")))
        if mode == "eof":
            sys.exit(0)
        if mode == "partial":
            sys.stdout.write('{"id":2,"result":')
            sys.stdout.flush()
            time.sleep(60)
        print(json.dumps({"method": "account/updated", "params": {}}), flush=True)
        if mode == "garbage":
            print("not JSON", flush=True)
        if mode == "nonobject":
            print("[1,2,3]", flush=True)
        if mode == "chatty":
            sys.stderr.write("secret-account-id" * 100000)
            sys.stderr.flush()
        if mode == "rpc-error":
            print(json.dumps({"id": request["id"], "error": {
                "code": -1, "message": "secret-account-id secret-credit-id"}}), flush=True)
            continue
        if mode == "bad-result":
            result = {"accountId": "secret-account-id", "rateLimits": "secret-credit-id"}
        elif os.environ.get("FAKE_CODEX_FILE"):
            result = json.loads(Path(os.environ["FAKE_CODEX_FILE"]).read_text())
        else:
            now = int(datetime.now(timezone.utc).timestamp())
            result = {"accountId": "secret-account-id", "rateLimits": {
                "primary": {"usedPercent": 20, "windowDurationMins": 300, "resetsAt": now + 7200},
                "secondary": {"usedPercent": 30, "windowDurationMins": 10080, "resetsAt": now + 172800},
                "credits": {"id": "secret-credit-id"}}}
        print(json.dumps({"id": request["id"], "result": result}), flush=True)
    sys.exit(0)

assert args[0] == "exec" and "--json" in args, args
if "resume" in args:
    assert "fake-codex-thread" in args, args
prompt = sys.stdin.read()
wt = Path(args[args.index("-C") + 1]) if "-C" in args else Path.cwd()
last = Path(args[args.index("-o") + 1])
read_only = ("read-only" in args or 'sandbox_mode="read-only"' in args)
assert not any(k in os.environ for k in ("CLAUDECODE", "VSCODE_FAKE", "LD_LIBRARY_PATH"))
review = prompt.startswith("# Review request")
if not read_only:
    with (wt / "tracked.txt").open("a") as f:
        f.write("codex round\n")
    with (wt / "new-codex.txt").open("a") as f:
        f.write("new codex line\n")
if review:
    assert read_only
    assert list((wt / ".delegate").glob("review-*.verify.log"))
    answer = "## Verdict\nVerdict: APPROVE\n## Findings\nNone.\n## Spec compliance\n- met\n"
else:
    answer = "## Changes\nUpdated tracked.txt and new-codex.txt.\n## Verification\nChecks passed.\n## Open questions / conflicts\nNone.\n"
answer += "\n## Digest\nfiles: tracked.txt (+1/-0); new-codex.txt (+1/-0)\nverify: git diff --check -> pass\nconflicts: none\nrisks: none\n"
last.write_text(answer)


def emit(event):
    print(json.dumps(event), flush=True)


print("Reading additional input from stdin...")
emit({"type": "thread.started", "thread_id": "fake-codex-thread"})
emit({"type": "turn.started"})
emit({"type": "item.completed", "item": {"id": "item_0", "type": "reasoning", "text": "Inspecting the requested change."}})
emit({"type": "item.completed", "item": {"id": "item_1", "type": "command_execution", "command": "git diff --check", "exit_code": 0, "status": "completed"}})
if not read_only:
    emit({"type": "item.completed", "item": {"id": "item_2", "type": "file_change", "changes": [{"path": "tracked.txt", "kind": "update"}, {"path": "new-codex.txt", "kind": "add"}], "status": "completed"}})
# Like real Codex, usage is the running thread total; a resumed thread starts from the previous round's total.
b = (300, 90, 30, 12) if "resume" in args else (0, 0, 0, 0)
emit({"type": "turn.completed", "usage": {"input_tokens": 100 + b[0], "cached_input_tokens": 40 + b[1], "cache_write_input_tokens": 0, "output_tokens": 10 + b[2], "reasoning_output_tokens": 5 + b[3]}})
emit({"type": "turn.started"})
emit({"type": "item.completed", "item": {"id": "item_3", "type": "agent_message", "text": answer}})
emit({"type": "item.completed", "item": {"id": "item_4", "type": "future_item"}})
emit({"type": "turn.completed", "usage": {"input_tokens": 300 + b[0], "cached_input_tokens": 90 + b[1], "cache_write_input_tokens": 0, "output_tokens": 30 + b[2], "reasoning_output_tokens": 12 + b[3]}})
sys.exit(int(os.environ.get("FAKE_AGENT_EXIT", "0")))
